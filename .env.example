# Base URL of your Nightscout API, including the /api/v1 suffix.
# The proxy derives the v3 and auth endpoints from the site root.
NIGHTSCOUT_URL=https://your-nightscout-site.com/api/v1

# Subject token from Nightscout Admin Tools. Required: reads use API v3, which
# rejects unauthenticated requests. The proxy exchanges it for a ~8h JWT and
# caches that until shortly before expiry. Prefer a "readable"-role subject.
NIGHTSCOUT_TOKEN=reader-0123456789abcdef

# Only needed for writes (recordInsulinOrder). Leave unset for read-only.
NIGHTSCOUT_API_SECRET=

# Local dev server port.
PORT=4000
